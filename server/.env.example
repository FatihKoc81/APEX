# OpenAI API (kullanımı ücretlidir; model seçimini OPENAI_MODEL ile yapın)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OpenRouter ücretsiz yönlendirici ve isteğe bağlı :free Kimi/DeepSeek model kimlikleri (OPENROUTER_MODEL varsayılanı: openrouter/free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Mevcut Gemini API anahtarın
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=https://github.com/FatihKoc81/APEX
MAX_STEPS_PER_TASK=24
MAX_TASK_MINUTES=90
PORT=8787

# Kimi/DeepSeek yalnızca OpenRouter katalogunda gerçekten :free model kimliği varsa etkinleşir.
KIMI_MODEL=
DEEPSEEK_MODEL=

# OmniRoute unified AI gateway (connect provider accounts in its dashboard first)
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/coding
